CONTAINER_NAME= # Name the container!
LOCAL_PORT=8000 # The port on this machine
REMOTE_SERVER=example.remote.server.com # Remote SSH server
REMOTE_USER=davidhfrankelcodes # User on REMOTE_SERVER
REMOTE_PORT=8888 # The port on REMOTE_SERVER
TUNNEL_TYPE=L # Must be `L` for local or `R` for reverse

# Optional: watchdog that restarts the container when the tunnel's port stops answering
# HEALTHCHECK_ENABLED=true # Set to `false` to disable
# HEALTHCHECK_HOST= # Defaults to REMOTE_SERVER for `R`, localhost for `L`
# HEALTHCHECK_PORT= # Defaults to REMOTE_PORT for `R`, LOCAL_PORT for `L`
# HEALTHCHECK_INTERVAL=60 # Seconds between checks
# HEALTHCHECK_RETRIES=3 # Consecutive failures before restarting
# HEALTHCHECK_START_PERIOD=30 # Seconds to wait before the first check
# HEALTHCHECK_TIMEOUT=5 # Seconds before a single check times out
